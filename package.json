{
  "name": "yummix",
  "private": true,
  "version": "0.1.0",
  "description": "Yummix — professional multi-restaurant food delivery platform (monorepo)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,CUSTOMER,RESTAURANT,KDS,COURIER,ADMIN -c blue,green,yellow,magenta,cyan,red \"npm:dev:api\" \"npm:dev:customer\" \"npm:dev:restaurant\" \"npm:dev:kds\" \"npm:dev:courier\" \"npm:dev:admin\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:customer": "npm run dev -w apps/customer",
    "dev:restaurant": "npm run dev -w apps/restaurant",
    "dev:kds": "npm run dev -w apps/kds",
    "dev:courier": "npm run dev -w apps/courier",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/customer --if-present",
    "qa:typecheck": "npm run qa:typecheck -w apps/api",
    "qa:test": "npm run qa:test -w apps/api",
    "qa:snapshot": "npm run qa:snapshot -w apps/api",
    "qa:functional": "npm run qa:functional -w apps/api",
    "qa:load": "npm run qa:load -w apps/api",
    "qa:cleanup": "npm run qa:cleanup -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:studio": "npm run db:studio -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
