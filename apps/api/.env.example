# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. Local dev via docker-compose:
DATABASE_URL="postgresql://yummix:yummix@localhost:5432/yummix?schema=public"

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rider dispatch tuning
MAX_ASSIGNMENT_RETRIES=5
ASSIGNMENT_OFFER_TTL_SECONDS=60
