# Runtime
NODE_ENV=development
PORT=4000

# Database (Supabase PostgreSQL in staging/production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Comma-separated browser origins allowed to call the API.
# Local example includes every VAIPIZZA frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Generate independent high-entropy secrets. Production requires >= 32 chars.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Franchise notifications — use an app password, never your normal mailbox password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRANCHISE_NOTIFY_EMAIL=vaipizzapt@gmail.com
PRIMARY_RESTAURANT_SLUG=vaipizza

# Payments (optional until card payments are enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dispatch
ASSIGNMENT_OFFER_TTL_SECONDS=60
COURIER_LOCATION_MAX_AGE_SECONDS=120
COURIER_MAX_ACCURACY_METERS=100
DISPATCH_FAIRNESS_WINDOW_MINUTES=30

# Security defaults
ALLOW_PUBLIC_COURIER_REGISTRATION=false
PASSWORD_RESET_DEBUG_LOG=false
